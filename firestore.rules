rules_version = '2';

// Paste this into Firebase console → Firestore Database → Rules, then Publish.
//
// Regular users: can only read/write their own /users/{uid} document and its cars,
// scheduledServices, history, and records subcollections. Signed-out requests are rejected.
//
// Admins: anyone with a document at /admins/{their uid}. Admins can read and manage every
// user's profile and subcollections. Admin documents can only be created by hand in the
// Firebase console (nobody can grant themselves admin from the app) - see ADMIN_SETUP.md.
//
// Mechanics: anyone can sign up as a mechanic, but the account does nothing until an admin
// approves it (`mechanicApproved: true`, which only admins can set). An approved mechanic can
// read every customer's booked services/checkups and accept them, move them to in-progress or
// completed, or release them. They can only change the response fields listed below - never a
// customer's cars, profile, or the booking details themselves.
//
// Messages: /conversations/{idA_idB} holds a chat between exactly two users (the two uids,
// sorted, joined with "_"), with its messages in a `messages` subcollection. Only the two people
// in a chat can read or write it, and messages can't be edited or deleted. Any two signed-in people
// can chat (customer to customer, customer to mechanic). To start one you need the other person's
// uid, which you get from /emailIndex by knowing their exact email (see below).
//
// Email index: /emailIndex/{email in lowercase} = { uid, name, role }. Each account writes only its
// own entry. Anyone signed in can read an entry if they know the exact email, but entries can't be
// listed, so there is no public directory of users.
//
// Push tokens: /pushTokens/{uid} stores the device token used to notify that user. Only the owner
// can write it. Approved mechanics and people who share a chat with the user can read it, so the
// app can send them a notification (for example when a mechanic accepts a service).
//
// Disabled accounts: an admin can set `disabled: true` on a user's profile. A disabled user
// can still read their own profile (so the app can tell them and sign them out) but can no
// longer read or write anything else. Users can never change `disabled` themselves.
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function isDisabled(userId) {
      return exists(/databases/$(database)/documents/users/$(userId))
        && get(/databases/$(database)/documents/users/$(userId)).data.get('disabled', false) == true;
    }

    function userData(userId) {
      return get(/databases/$(database)/documents/users/$(userId)).data;
    }

    // A mechanic account an admin has approved (and hasn't disabled).
    function isApprovedMechanic() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && userData(request.auth.uid).get('role', 'customer') == 'mechanic'
        && userData(request.auth.uid).get('mechanicApproved', false) == true
        && userData(request.auth.uid).get('disabled', false) != true;
    }

    // What a mechanic is allowed to do to a customer's booked service (all other fields are frozen):
    //   accept   - a request nobody has taken yet becomes theirs
    //   progress - their own job moves to in_progress / completed
    //   release  - their own job goes back to the pool
    function mechanicCanRespond() {
      let before = resource.data;
      let after = request.resource.data;
      return after.diff(before).affectedKeys().hasOnly(['status', 'mechanicId', 'mechanicName', 'respondedAt', 'completedAt'])
        && (
          (before.get('status', 'pending') == 'pending'
            && after.get('status', '') == 'accepted'
            && after.get('mechanicId', '') == request.auth.uid)
          || (before.get('mechanicId', '') == request.auth.uid
            && before.get('status', 'pending') in ['accepted', 'in_progress']
            && after.get('status', '') in ['in_progress', 'completed']
            && after.get('mechanicId', '') == request.auth.uid)
          || (before.get('mechanicId', '') == request.auth.uid
            && before.get('status', 'pending') in ['accepted', 'in_progress']
            && after.get('status', '') == 'pending'
            && after.get('mechanicId', '') == '')
        );
    }

    // A mechanic may only change the status label of the history entry that belongs to a job that
    // is currently theirs. History ids are "<serviceId>-history".
    function mechanicCanUpdateHistory(userId, historyId) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
        && request.resource.data.get('status', '') in ['Scheduled', 'In Progress', 'Completed']
        && get(/databases/$(database)/documents/users/$(userId)/scheduledServices/$(historyId.replace('-history$', ''))).data.get('mechanicId', '') == request.auth.uid;
    }

    // When a mechanic completes their job, the app logs it in the customer's Records. The record id is
    // "<serviceId>-record" and the booking must currently belong to this mechanic.
    function mechanicCanLogRecord(userId, recordId) {
      return request.resource.data.keys().hasOnly(['id', 'carId', 'title', 'value', 'detail', 'source', 'createdAt'])
        && request.resource.data.source == 'mechanic'
        && request.resource.data.id == recordId
        && get(/databases/$(database)/documents/users/$(userId)/scheduledServices/$(recordId.replace('-record$', ''))).data.get('mechanicId', '') == request.auth.uid;
    }

    // Owner of the data AND not disabled, or an admin.
    function canAccessUserData(userId) {
      return (isOwner(userId) && !isDisabled(userId)) || isAdmin();
    }

    // Signed in, not disabled, and (for mechanics) approved by an admin.
    function canChat() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && userData(request.auth.uid).get('disabled', false) != true
        && (userData(request.auth.uid).get('role', 'customer') != 'mechanic'
          || userData(request.auth.uid).get('mechanicApproved', false) == true);
    }

    function isChatParticipant(conversationId) {
      return isSignedIn()
        && request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants;
    }

    match /conversations/{conversationId} {
      // `resource == null` lets a person check whether a chat already exists before creating it.
      allow get: if isSignedIn() && (resource == null || request.auth.uid in resource.data.participants);
      allow list: if isSignedIn() && request.auth.uid in resource.data.participants;

      allow create: if canChat()
        && request.resource.data.keys().hasOnly(['participants', 'names', 'roles', 'lastMessage', 'lastMessageAt', 'lastSenderId', 'readAt', 'createdAt'])
        && request.resource.data.participants.size() == 2
        && request.auth.uid in request.resource.data.participants
        && request.resource.data.participants[0] < request.resource.data.participants[1]
        && conversationId == request.resource.data.participants[0] + '_' + request.resource.data.participants[1];

      // Only the "last message" summary, read markers, mute switches and profile pictures change after a
      // chat is created. `muted` (uid -> true/false) and `avatars` (uid -> small picture) are maps in which
      // each person may only change their own entry.
      allow update: if canChat()
        && request.auth.uid in resource.data.participants
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastMessage', 'lastMessageAt', 'lastSenderId', 'readAt', 'muted', 'avatars'])
        && (!('muted' in request.resource.data.diff(resource.data).affectedKeys())
          || request.resource.data.muted.diff(resource.data.get('muted', {})).affectedKeys().hasOnly([request.auth.uid]))
        && (!('avatars' in request.resource.data.diff(resource.data).affectedKeys())
          || (request.resource.data.avatars.diff(resource.data.get('avatars', {})).affectedKeys().hasOnly([request.auth.uid])
            && request.resource.data.avatars[request.auth.uid] is string
            && request.resource.data.avatars[request.auth.uid].size() <= 60000));

      match /messages/{messageId} {
        allow read: if isChatParticipant(conversationId);
        allow create: if canChat()
          && isChatParticipant(conversationId)
          && request.resource.data.keys().hasOnly(['senderId', 'text', 'createdAt'])
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 2000
          && request.resource.data.createdAt == request.time;
        allow update, delete: if false;
      }
    }

    match /emailIndex/{emailKey} {
      allow get: if isSignedIn();
      allow list: if false;
      allow create, update: if isSignedIn()
        && request.auth.token.email != null
        && emailKey == request.auth.token.email.lower()
        && request.resource.data.keys().hasOnly(['uid', 'name', 'role'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 100
        && request.resource.data.role == userData(request.auth.uid).get('role', 'customer');
      allow delete: if isAdmin() || (isSignedIn() && resource.data.uid == request.auth.uid);
    }

    match /pushTokens/{userId} {
      allow get: if isOwner(userId)
        || isAdmin()
        || isApprovedMechanic()
        || exists(/databases/$(database)/documents/conversations/$(request.auth.uid + '_' + userId))
        || exists(/databases/$(database)/documents/conversations/$(userId + '_' + request.auth.uid));
      allow create, update: if isOwner(userId)
        && !isDisabled(userId)
        && request.resource.data.keys().hasOnly(['token', 'platform', 'updatedAt'])
        && request.resource.data.token is string
        && request.resource.data.token.size() < 300;
      allow delete: if isOwner(userId);
    }

    match /admins/{adminId} {
      // You can check whether you are an admin; admins can see who the other admins are.
      allow read: if isOwner(adminId) || isAdmin();
      allow write: if false;
    }

    // Lets approved mechanics list booked services across ALL customers with one collection-group
    // query. Reads only - what they can change is decided in the users/.../scheduledServices rule.
    match /{path=**}/scheduledServices/{serviceId} {
      allow read: if isApprovedMechanic();
    }

    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();

      // First write of a profile (sign-up). Users pick customer or mechanic, but can't create
      // themselves as disabled or as an already-approved mechanic.
      allow create: if (
          isOwner(userId)
          && !('disabled' in request.resource.data)
          && !('deletedByAdmin' in request.resource.data)
          && request.resource.data.get('role', 'customer') in ['customer', 'mechanic']
          && request.resource.data.get('mechanicApproved', false) == false
        )
        || isAdmin();

      allow update: if (
          isOwner(userId)
          && !isDisabled(userId)
          && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['disabled', 'deletedByAdmin', 'role', 'mechanicApproved'])
        )
        || isAdmin();

      allow delete: if isAdmin();

      match /cars/{carId} {
        allow read, write: if canAccessUserData(userId);
      }

      match /scheduledServices/{serviceId} {
        allow read: if canAccessUserData(userId);

        // New bookings always start as pending with no mechanic attached.
        allow create: if isAdmin()
          || (
            isOwner(userId)
            && !isDisabled(userId)
            && request.resource.data.get('status', 'pending') == 'pending'
            && !('mechanicId' in request.resource.data)
          );

        // Customers can edit their booking but can't touch the mechanic's response fields.
        allow update: if isAdmin()
          || (
            isOwner(userId)
            && !isDisabled(userId)
            && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['status', 'mechanicId', 'mechanicName', 'respondedAt', 'completedAt'])
          )
          || (isApprovedMechanic() && mechanicCanRespond());

        allow delete: if canAccessUserData(userId);
      }

      match /history/{historyId} {
        allow read, create, delete: if canAccessUserData(userId);
        allow update: if canAccessUserData(userId)
          || (isApprovedMechanic() && mechanicCanUpdateHistory(userId, historyId));
      }

      match /records/{recordId} {
        allow read, write: if canAccessUserData(userId);
        allow create: if isApprovedMechanic() && mechanicCanLogRecord(userId, recordId);
      }
    }
  }
}
