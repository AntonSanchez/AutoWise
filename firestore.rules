rules_version = '2';

// Paste this into Firebase console → Firestore Database → Rules, then Publish.
// Each signed-in user can only read/write their own /users/{uid} document and its
// cars, scheduledServices, history, and records subcollections. No one can read
// another user's data, and signed-out requests are rejected.
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      match /cars/{carId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      match /scheduledServices/{serviceId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      match /history/{historyId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      match /records/{recordId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }
  }
}
